 src/panfrost/vulkan/panvk_physical_device.c  |  42 +++++-
 src/panfrost/vulkan/panvk_physical_device.h  |   9 +-
 8 files changed, 320 insertions(+), 52 deletions(-)

diff --git a/include/drm-uapi/mali_kbase_ioctl.h b/include/drm-uapi/mali_kbase_ioctl.h
index 0a8ab52..4f82e8d 100644
--- a/include/drm-uapi/mali_kbase_ioctl.h
+++ b/include/drm-uapi/mali_kbase_ioctl.h
@@ -530,2 +530,4 @@ enum base_kcpu_command_type {
 #define BASEP_CQS_WAIT_OPERATION_GT 1
+#define BASEP_CQS_SET_OPERATION_ADD 0
+#define BASEP_CQS_SET_OPERATION_SET 1
 #define BASEP_CQS_DATA_TYPE_U32 0
@@ -558,2 +560,16 @@ struct base_kcpu_command_cqs_wait_operation_info {
 
+struct base_cqs_set_operation_info {
+   __u64 addr;
+   __u64 val;
+   __u8 operation;
+   __u8 data_type;
+   __u8 padding[6];
+};
+
+struct base_kcpu_command_cqs_set_operation_info {
+   __u64 objs;
+   __u32 nr_objs;
+   __u32 padding;
+};
+
 struct base_kcpu_command {
@@ -564,2 +580,3 @@ struct base_kcpu_command {
       struct base_kcpu_command_cqs_wait_operation_info cqs_wait_operation;
+      struct base_kcpu_command_cqs_set_operation_info cqs_set_operation;
       __u64 padding[2];
diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index cbc7a57..3d65cd8 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -236,8 +236,2 @@ struct kbase_kmod_dev {
 
-   struct {
-      simple_mtx_t lock;
-      base_kcpu_queue_id id;
-      bool valid;
-   } kcpu_export;
-
    simple_mtx_t atoms_lock;
@@ -1548,4 +1542,112 @@ out:
 
+void
+kbase_kmod_csf_kcpu_queue_init(struct kbase_kmod_kcpu_queue *queue)
+{
+   simple_mtx_init(&queue->lock, mtx_plain);
+   queue->id = UINT32_MAX;
+   queue->wait_unsupported = false;
+}
+
+void
+kbase_kmod_csf_kcpu_queue_finish(struct pan_kmod_dev *dev,
+                                struct kbase_kmod_kcpu_queue *queue)
+{
+   if (queue->id != UINT32_MAX) {
+      struct kbase_ioctl_kcpu_queue_delete delete = {.id = queue->id};
+      ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_DELETE, &delete);
+   }
+   simple_mtx_destroy(&queue->lock);
+}
+
+/* Each enqueue copies its argument and takes its own fence reference. */
+static int
+kbase_kcpu_enqueue(struct pan_kmod_dev *dev,
+                    struct kbase_kmod_kcpu_queue *queue,
+                    struct base_kcpu_command *command)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (!kd->is_csf) {
+      errno = ENOTSUP;
+      return -1;
+   }
+
+   if (queue->id == UINT32_MAX) {
+      struct kbase_ioctl_kcpu_queue_new create = {0};
+      if (ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_CREATE, &create))
+         return -1;
+      queue->id = create.id;
+   }
+
+   struct kbase_ioctl_kcpu_queue_enqueue enqueue = {
+      .addr = (uintptr_t)command,
+      .nr_commands = 1,
+      .id = queue->id,
+   };
+   return ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_ENQUEUE, &enqueue);
+}
+
+int
+kbase_kmod_csf_wait_sync_file(struct pan_kmod_dev *dev,
+                             struct kbase_kmod_kcpu_queue *queue, int fd,
+                             uint64_t addr, uint64_t value)
+{
+   STATIC_ASSERT(sizeof(struct base_cqs_set_operation_info) == 24);
+   STATIC_ASSERT(sizeof(struct base_kcpu_command) == 24);
+   if (fd < 0 || (addr & 15) || !value)
+      return -EINVAL;
+
+   struct base_fence fence = {.basep = {.fd = fd, .stream_fd = -1}};
+   struct base_cqs_set_operation_info set = {
+      .addr = addr,
+      .operation = BASEP_CQS_SET_OPERATION_SET,
+      .data_type = BASEP_CQS_DATA_TYPE_U64,
+   };
+   struct base_kcpu_command commands[] = {
+      {.type = BASE_KCPU_COMMAND_TYPE_FENCE_WAIT,
+       .info.fence.fence = (uintptr_t)&fence},
+      {.type = BASE_KCPU_COMMAND_TYPE_CQS_SET_OPERATION,
+       .info.cqs_set_operation = {.objs = (uintptr_t)&set, .nr_objs = 1}},
+   };
+
+   simple_mtx_lock(&queue->lock);
+   int ret = 0;
+   if (queue->wait_unsupported)
+      goto out;
+
+   /* Probe the stock kernel before queuing an unresolved fence. A rejected
+    * CQS command must leave the existing CPU wait path usable. */
+   if (queue->id == UINT32_MAX &&
+       kbase_kcpu_enqueue(dev, queue, &commands[1])) {
+      queue->wait_unsupported = true;
+      mesa_logw("kbase: native fence bridge unavailable: %s; using CPU waits",
+                strerror(errno));
+      goto out;
+   }
+
+   set.val = value;
+   for (unsigned i = 0; i < ARRAY_SIZE(commands); i++) {
+      if (kbase_kcpu_enqueue(dev, queue, &commands[i])) {
+         if (!i && (errno == EINVAL || errno == ENOTTY || errno == ENOTSUP)) {
+            queue->wait_unsupported = true;
+            mesa_logw("kbase: native fence wait unavailable: %s; using CPU waits",
+                      strerror(errno));
+            ret = 0;
+         } else {
+            ret = -errno;
+         }
+         goto out;
+      }
+   }
+   ret = 1;
+
+out:
+   simple_mtx_unlock(&queue->lock);
+   /* A failure after FENCE_WAIT was accepted cannot fall back or publish
+    * dependent GPU work. The caller must fail the Vulkan queue. */
+   return ret;
+}
+
 int
 kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
+                                  struct kbase_kmod_kcpu_queue *queue,
                                   const uint64_t *addrs,
@@ -1569,2 +1671,3 @@ kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
             .nr_objs = count,
+            .inherit_err_flags = BITFIELD_MASK(count),
          },
@@ -1602,21 +1705,6 @@ kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
 
-   simple_mtx_lock(&kbase_dev->kcpu_export.lock);
-   if (!kbase_dev->kcpu_export.valid) {
-      struct kbase_ioctl_kcpu_queue_new create = {0};
-      if (ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_CREATE, &create)) {
-         simple_mtx_unlock(&kbase_dev->kcpu_export.lock);
-         return -1;
-      }
-      kbase_dev->kcpu_export.id = create.id;
-      kbase_dev->kcpu_export.valid = true;
-   }
-
+   simple_mtx_lock(&queue->lock);
    for (unsigned i = count ? 0 : 1; i < 2; i++) {
-      struct kbase_ioctl_kcpu_queue_enqueue enqueue = {
-         .addr = (uintptr_t)&commands[i],
-         .nr_commands = 1,
-         .id = kbase_dev->kcpu_export.id,
-      };
-      if (ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_ENQUEUE, &enqueue)) {
-         simple_mtx_unlock(&kbase_dev->kcpu_export.lock);
+      if (kbase_kcpu_enqueue(dev, queue, &commands[i])) {
+         simple_mtx_unlock(&queue->lock);
          return -1;
@@ -1624,3 +1712,3 @@ kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
    }
-   simple_mtx_unlock(&kbase_dev->kcpu_export.lock);
+   simple_mtx_unlock(&queue->lock);
 
@@ -2193,3 +2281,2 @@ kbase_kmod_dev_create(int fd, uint32_t flags,
    simple_mtx_init(&kbase_dev->kcpu.lock, mtx_plain);
-   simple_mtx_init(&kbase_dev->kcpu_export.lock, mtx_plain);
    simple_mtx_init(&kbase_dev->nc_lock, mtx_plain);
@@ -2367,9 +2454,2 @@ kbase_kmod_dev_destroy(struct pan_kmod_dev *dev)
 
-   if (kbase_dev->kcpu_export.valid) {
-      struct kbase_ioctl_kcpu_queue_delete delete = {
-         .id = kbase_dev->kcpu_export.id,
-      };
-      ioctl(dev->fd, KBASE_IOCTL_KCPU_QUEUE_DELETE, &delete);
-   }
-   simple_mtx_destroy(&kbase_dev->kcpu_export.lock);
    simple_mtx_destroy(&kbase_dev->nc_lock);
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
index 1782cf9..69863e0 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -9,2 +9,3 @@
 #include <stdint.h>
+#include "util/simple_mtx.h"
 
@@ -167,3 +168,21 @@ int kbase_kmod_csf_wait_cqs64(struct pan_kmod_dev *dev, uint64_t addr,
 
+/* Separate queues for imported waits and exported signals, owned by each
+ * Vulkan queue. Never put a later imported wait ahead of an earlier signal. */
+struct kbase_kmod_kcpu_queue {
+   simple_mtx_t lock;
+   uint32_t id;
+   bool wait_unsupported;
+};
+
+void kbase_kmod_csf_kcpu_queue_init(struct kbase_kmod_kcpu_queue *queue);
+/* GPU consumers must be terminated before deleting a queue with pending
+ * commands: KCPU deletion cancels waits but still executes later CQS sets. */
+void kbase_kmod_csf_kcpu_queue_finish(struct pan_kmod_dev *dev,
+                                      struct kbase_kmod_kcpu_queue *queue);
+/* 1: queued; 0: unsupported (use the CPU wait); negative: submission failed. */
+int kbase_kmod_csf_wait_sync_file(struct pan_kmod_dev *dev,
+                                  struct kbase_kmod_kcpu_queue *queue,
+                                  int fd, uint64_t addr, uint64_t value);
 int kbase_kmod_csf_export_cqs64_fence(struct pan_kmod_dev *dev,
+                                      struct kbase_kmod_kcpu_queue *queue,
                                       const uint64_t *addrs,
