diff --git a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
index a960824..c5cec9e 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
@@ -79,2 +79,6 @@ static_assert(KBASE_STATS_TS_OFFSET(PANVK_SUBQUEUE_COUNT) <= 4096,
 #define KBASE_CACHELINE_SIZE 64
+/* Keep the wait counter on its own cache line, outside completion cells and
+ * stats. Two KCPU commands per wait fit 64 outstanding waits in its FIFO. */
+#define KBASE_FENCE_WAIT_OFFSET 256
+#define KBASE_FENCE_WAIT_MAX_PENDING 64
 /* With firmware chunk recycling disarmed (no FRAGMENT_COMPLETED heap ops on
@@ -230,2 +234,22 @@ kbase_subqueue_seqno_dev_addr(struct panvk_gpu_queue *queue, uint32_t subqueue)
 
+static volatile struct panvk_cs_sync64 *
+kbase_fence_wait_cell(struct panvk_gpu_queue *queue)
+{
+   return (volatile struct panvk_cs_sync64 *)
+      ((uint8_t *)queue->kbase_seqnos.cpu + KBASE_FENCE_WAIT_OFFSET);
+}
+
+static VkResult
+kbase_fence_wait_status(struct panvk_gpu_queue *queue)
+{
+   if (!queue->kbase_fence_wait_seqno)
+      return VK_SUCCESS;
+
+   volatile struct panvk_cs_sync64 *cell = kbase_fence_wait_cell(queue);
+   kbase_cache_invalidate_range((const void *)cell, KBASE_CACHELINE_SIZE);
+   if (cell->error)
+      return vk_queue_set_lost(&queue->vk, "kbase: imported native fence failed");
+   return VK_SUCCESS;
+}
+
 static uint64_t
@@ -630,2 +654,12 @@ kbase_subqueue_emit_job(struct panvk_gpu_queue *queue, uint32_t subqueue,
 
+   if (queue->kbase_fence_waits[subqueue]) {
+      flush_id = 0;
+      cs_move64_to(&b, addr64,
+                   queue->kbase_seqnos.dev + KBASE_FENCE_WAIT_OFFSET);
+      cs_move64_to(&b, val64, queue->kbase_fence_waits[subqueue] - 1);
+      /* Inherit errors into the completion cell and exported fence, rather
+       * than turning an errored input into a successful dependent job. */
+      cs_sync64_wait(&b, false, MALI_CS_CONDITION_GREATER, val64, addr64);
+   }
