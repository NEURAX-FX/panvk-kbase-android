 src/panfrost/lib/kmod/kbase_kmod.c           | 146 ++++++++++++++-----
 src/panfrost/lib/kmod/kbase_kmod.h           |  19 +++
 src/panfrost/vulkan/csf/panvk_queue.h        |  13 +-
