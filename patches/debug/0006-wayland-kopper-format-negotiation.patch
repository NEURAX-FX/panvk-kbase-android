+static bool
+dri2_wl_kopper_get_formats(struct dri2_egl_display *dri2_dpy, bool *supported)
+{
+   struct dri2_wl_kopper_registry state = { .display = dri2_dpy };
+   struct wl_surface *surface = NULL;
+   bool success = false;
+   static const struct wl_registry_listener listener = {
+      .global = kopper_registry_global,
+      .global_remove = kopper_registry_global_remove,
+   };
+   struct wl_registry *registry =
+      wl_display_get_registry(dri2_dpy->wl_dpy_wrapper);
+   if (!registry)
+      return false;
+   wl_registry_add_listener(registry, &listener, &state);
+   if (roundtrip(dri2_dpy) < 0 || !state.compositor)
+      goto out;
+
+   surface = wl_compositor_create_surface(state.compositor);
+   if (!surface)
+      goto out;
+
+   struct kopper_loader_info info = { .initial_swap_interval = 1 };
+   VkWaylandSurfaceCreateInfoKHR *create_info = (void *)&info.bos;
+   *create_info = (VkWaylandSurfaceCreateInfoKHR) {
+      .sType = VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR,
+      .display = dri2_dpy->wl_dpy,
+      .surface = surface,
+   };
+   enum pipe_format formats[ARRAY_SIZE(dri2_wl_visuals)];
+   for (unsigned i = 0; i < ARRAY_SIZE(formats); i++)
+      formats[i] = dri2_wl_visuals[i].pipe_format;
+   success = kopperQuerySurfaceFormats(dri2_dpy->dri_screen_render_gpu, &info,
+                                       ARRAY_SIZE(formats), formats, supported);
+
+out:
+   if (surface)
+      wl_surface_destroy(surface);
+   if (state.compositor)
+      wl_compositor_destroy(state.compositor);
+#ifdef WL_FIXES_INTERFACE
+   if (dri2_dpy->wl_fixes)
+      wl_fixes_destroy_registry(dri2_dpy->wl_fixes, registry);
+#endif
+   wl_registry_destroy(registry);
+   return success;
+}
