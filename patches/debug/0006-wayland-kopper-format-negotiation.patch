+bool
+zink_kopper_query_surface_formats(struct pipe_screen *pscreen,
+                                  const struct kopper_loader_info *info,
+                                  unsigned num_formats,
+                                  const enum pipe_format *formats,
+                                  bool *supported)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct kopper_displaytarget cdt = { .info = *info };
+   VkSurfaceKHR surface = kopper_CreateSurface(screen, &cdt);
+   if (surface == VK_NULL_HANDLE)
+      return false;
+
+   VkSurfaceFormatKHR *surface_formats = NULL;
+   uint32_t count = 0;
+   VkResult result;
+   do {
+      free(surface_formats);
+      surface_formats = NULL;
+      result = VKSCR(GetPhysicalDeviceSurfaceFormatsKHR)(screen->pdev, surface,
+                                                        &count, NULL);
+      if (result != VK_SUCCESS || !count)
+         goto out;
+      surface_formats = MALLOC(sizeof(*surface_formats) * count);
+      if (!surface_formats) {
+         result = VK_ERROR_OUT_OF_HOST_MEMORY;
+         goto out;
+      }
+      result = VKSCR(GetPhysicalDeviceSurfaceFormatsKHR)(screen->pdev, surface,
+                                                        &count, surface_formats);
+   } while (result == VK_INCOMPLETE);
+   if (result != VK_SUCCESS)
+      goto out;
+
+   VkColorSpaceKHR colorspace = cdt.type == KOPPER_WAYLAND
+                                  ? VK_COLOR_SPACE_PASS_THROUGH_EXT
+                                  : VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+   for (unsigned i = 0; i < num_formats; i++) {
+      VkFormat format = zink_get_format(screen, formats[i]);
+      supported[i] = false;
+      for (uint32_t j = 0; j < count; j++) {
+         if (surface_formats[j].format == format &&
+             surface_formats[j].colorSpace == colorspace) {
+            supported[i] = true;
+            break;
+         }
+      }
+   }
+
+out:
+   free(surface_formats);
+   VKSCR(DestroySurfaceKHR)(screen->instance, surface, NULL);
+   return result == VK_SUCCESS && count > 0;
+}
