+void
+zink_kopper_release_drawable(struct pipe_screen *pscreen,
+                            const struct kopper_loader_info *info)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct kopper_displaytarget key = { .info = *info };
+   init_dt_type(&key);
+
+   simple_mtx_lock(&screen->dt_lock);
+   if (screen->dts.table) {
+      struct hash_entry *he = find_dt_entry(screen, &key);
+      if (he)
+         _mesa_hash_table_remove(&screen->dts, he);
+   }
+   simple_mtx_unlock(&screen->dt_lock);
+}
+
