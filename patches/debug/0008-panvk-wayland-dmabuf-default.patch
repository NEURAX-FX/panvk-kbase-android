    wsi->x11.extra_xwayland_image = device_options->extra_xwayland_image;
    wsi->wayland.disable_timestamps = (WSI_DEBUG & WSI_DEBUG_NOWLTS) != 0;
+   wsi->wayland.dmabuf = device_options->wayland_dmabuf &&
+                         !(WSI_DEBUG & WSI_DEBUG_SW);
    wsi->emulate_24as32 = device_options->emulate_24as32;
 #define WSI_GET_CB(func) \
    PFN_vk##func func = (PFN_vk##func)proc_addr(pdevice, "vk" #func)
@@ -222,7 +224,7 @@ wsi_device_init(struct wsi_device *wsi,
    WSI_GET_CB(GetImageDrmFormatModifierPropertiesEXT);
    WSI_GET_CB(GetImageMemoryRequirements);
    WSI_GET_CB(GetImageSubresourceLayout);
-   if (!wsi->sw)
+   if (!wsi->sw || wsi->wayland.dmabuf)
       WSI_GET_CB(GetMemoryFdKHR);
    WSI_GET_CB(GetPhysicalDeviceCalibrateableTimeDomainsKHR);
    WSI_GET_CB(GetPhysicalDeviceProperties);
@@ -2912,7 +2914,8 @@ wsi_common_queue_present(const struct wsi_device *wsi,
 #endif
       }
 
-      if (wsi->sw && !swapchain->sw_fence_wait_in_present_thread) {
+      if (wsi->sw && swapchain->image_info.image_type == WSI_IMAGE_TYPE_CPU &&
+          !swapchain->sw_fence_wait_in_present_thread) {
          wsi->WaitForFences(vk_device_to_handle(dev),
                             1, &swapchain->fences[image_index], true, ~0ull);
       }
diff --git a/src/vulkan/wsi/wsi_common.h b/src/vulkan/wsi/wsi_common.h
index 576f1fe..c316fef 100644
--- a/src/vulkan/wsi/wsi_common.h
