-   const bool kbase_dmabuf =
+   const bool kbase_can_export_dmabuf =
 #if defined(HAVE_PAN_KMOD_KBASE)
-      uses_kbase &&
-      ((!dri3_option && termux_raw_dri3) ||
-       (dri3_option && strcmp(dri3_option, "0") != 0)) &&
-      kbase_kmod_supports_dmabuf(physical_device->kmod.dev);
+      uses_kbase && kbase_kmod_supports_dmabuf(physical_device->kmod.dev);
 #else
       false;
 #endif
-   /* The CPU readback (sw) path copies every frame twice on Wayland: GPU
-    * image -> readback buffer -> wl_shm, then the compositor uploads the SHM
-    * buffer again.  kbase dma-heap BOs can be shared with the compositor
-    * instead (MT6989 niri/Anland, 2392x1080 glmark2: ~100-135 -> 280-420), so
-    * Wayland uses linux-dmabuf while X11 keeps MIT-SHM, whose servers
-    * (Xvfb, Termux:X11) cannot import these buffers.
-    * PANVK_WSI_WAYLAND_DMABUF=0 restores wl_shm. */
+   const bool kbase_dmabuf =
+      kbase_can_export_dmabuf &&
+      (termux_raw_dri3 || (dri3_option && strcmp(dri3_option, "0") != 0));
+   /* Without an override, use DRI3 only on capable Xwayland connections.
+    * Keep other X11 servers on the CPU path: some advertise DRI3 but cannot
+    * import our dma-bufs. PANVK_KBASE_DRI3=0 disables this default. */
+   const bool xwayland_dmabuf =
+      kbase_can_export_dmabuf && !dri3_option && !termux_raw_dri3;
    const bool wayland_dmabuf =
-#if defined(HAVE_PAN_KMOD_KBASE)
-      uses_kbase && !kbase_dmabuf &&
-      debug_get_bool_option("PANVK_WSI_WAYLAND_DMABUF", true) &&
-      kbase_kmod_supports_dmabuf(physical_device->kmod.dev);
-#else
-      false;
-#endif
+      kbase_can_export_dmabuf && !kbase_dmabuf &&
+      debug_get_bool_option("PANVK_WSI_WAYLAND_DMABUF", true);
    VkResult result;
 
    result = wsi_device_init(&physical_device->wsi_device,
@@ -752,6 +745,7 @@
                                 * fourth image when the server is Xwayland. */
                                .extra_xwayland_image =
                                   kbase_dmabuf && kbase_raw_dri3,
+                               .xwayland_dmabuf = xwayland_dmabuf,
                                .wayland_dmabuf = wayland_dmabuf,
                             });
    if (result != VK_SUCCESS)
@@ -763,14 +757,11 @@
     */
    physical_device->wsi_device.disable_unordered_submits = uses_kbase;
 
-   /* kbase is not a DRM fd.  The default CPU WSI path presents through
-    * MIT-SHM.  Android dma-heaps can also provide shareable
-    * allocations, but some Android X servers advertise DRI3 while rejecting
-    * standard PixmapFromBuffer.  PANVK_KBASE_DRI3=raw (or termux) uses the
-    * Termux:X11/Winlator private raw-FD modifier instead of DRM modifiers.
-    */
+   /* PANVK_KBASE_DRI3=raw (or termux) uses the Termux:X11/Winlator private
+    * raw-FD transport instead of negotiating DRM modifiers. */
    physical_device->wsi_device.supports_modifiers =
-      !uses_kbase || (kbase_dmabuf && !kbase_raw_dri3) || wayland_dmabuf;
+      !uses_kbase || (kbase_dmabuf && !kbase_raw_dri3) || wayland_dmabuf ||
+      xwayland_dmabuf;
    physical_device->wsi_device.can_present_on_device =
       panvk_can_present_on_device;
 
